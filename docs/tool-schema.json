    {
      "name": "as_heartbeat_set",
      "description": "Register/update an expiring self-chat clock schedule. No capability/catalog/worktime configuration is required; check_id supplies the default label. No external polling success ACK.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend_id": {
            "type": "string",
