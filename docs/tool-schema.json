    {
      "name": "as_goal_set",
      "description": "Set explicit goal fields. origin=user requires an actual user request; automatic supplies no user authorization. Accepted is not completed.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "caller_thread_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "thread_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "blocked",
              "complete"
            ]
          },
          "token_budget": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "automatic"
            ]
          },
          "expected_goal_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "caller_thread_id",
          "operation_id",
          "thread_id",
          "origin"
        ]
      },
