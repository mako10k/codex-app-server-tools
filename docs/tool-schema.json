    {
      "name": "as_chat_manage",
      "description": "Explicit chat management. Changes require caller_thread_id and operation_id. create: cwd; fork/resume/unarchive: thread_id; rename: thread_id+name; archive: thread_id+expected_descendants; interrupt: thread_id+expected_turn_id. operation_status is read-only and requires caller_thread_id+query_operation_id. No shell, delete or policy overrides.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "caller_thread_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "fork",
              "rename",
              "archive",
              "unarchive",
              "resume",
              "interrupt",
              "operation_status"
            ]
          },
          "thread_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "last_turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "expected_turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "expected_descendants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "maxItems": 100
          },
          "include_descendants": {
            "type": "boolean"
          },
          "query_operation_id": {
