            "maxLength": 160
          },
          "expected_generation": {
            "type": "integer",
            "minimum": 1
          },
          "starts_at": {
            "type": "string",
            "maxLength": 40
          },
          "expires_at": {
            "type": "string",
            "maxLength": 40
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "interval_seconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 86400
                },
                "first_due_at": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "required": [
                "check_id",
                "interval_seconds"
              ]
            }
          }
        },
        "required": [
          "caller_thread_id",
          "operation_id",
          "starts_at",
          "expires_at",
          "checks"
