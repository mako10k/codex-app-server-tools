{
  "tools": [
    {
      "name": "as_status",
      "description": "Read the local plugin management plane without starting a controller or connecting to App Server. Unknown stop reasons remain unknown.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "caller_thread_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "query_operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "as_control",
      "description": "Control only this candidate profile. service_set takes service+enabled; reconnect takes service=proxy; compatibility_set takes registration+expected_settings_digest; compatibility_reload rechecks versions. Requires actual caller metadata. Shared App Server and pinned monitors are excluded.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "caller_thread_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "action": {
            "type": "string",
            "enum": [
              "service_set",
              "reconnect",
              "compatibility_set",
              "compatibility_reload"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "controller",
              "proxy",
              "watch",
              "heartbeat"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "expected_settings_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "registration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "proxy_cli_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "app_server_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "decision": {
                "type": "string",
                "enum": [
                  "unknown",
                  "compatible",
                  "incompatible"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            },
            "required": [
              "proxy_cli_version",
              "app_server_version",
              "decision",
              "reason",
              "evidence"
            ]
          }
        },
        "required": [
          "caller_thread_id",
          "operation_id",
          "action"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
